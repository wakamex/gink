#!/usr/bin/env python3
"""Writes THIRD-PARTY-LICENSES.md: the licence of everything compiled into gink, for shipping beside it.

    tools/third-party-licenses OUT.md

It reads the packages Zig fetched for the pinned gesso (zig-pkg/, after `zig build`) and has
cargo-about (`cargo install cargo-about --features cli`) gather the Rust crates' licences from
core/about.toml. The fonts shipped beside the program are in assets/NOTICE.md, which ships too.
"""

import os
import re
import subprocess
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
FFMPEG = "https://ffmpeg.org/releases/ffmpeg-9.0.2.tar.xz"


def hash_of(zon, name):
    text = open(zon).read()
    return re.search(r"\." + name + r" = \.\{.*?\.hash = \"([^\"]+)\"", text, re.S).group(1)


def main():
    out = sys.argv[1]
    pkg = os.path.join(ROOT, "zig-pkg")
    gesso = os.path.join(pkg, hash_of(os.path.join(ROOT, "build.zig.zon"), "gesso"))
    zon = os.path.join(gesso, "build.zig.zon")
    # (what gesso compiles into gink, each with the file that holds its licence)
    parts = [
        ("gesso", "MIT", os.path.join(gesso, "LICENSE")),
        ("SDL3", "zlib", os.path.join(pkg, hash_of(zon, "sdl"), "LICENSE.txt")),
        ("Opus", "BSD-3-Clause", os.path.join(pkg, hash_of(zon, "opus"), "COPYING")),
        ("FFmpeg 9.0.2 (libavcodec, libavutil)", "LGPL-2.1-or-later", os.path.join(pkg, hash_of(zon, "ffmpeg"), "COPYING.LGPLv2.1")),
    ]
    for name in sorted(os.listdir(os.path.join(gesso, "vendor"))):
        for file in ("LICENSE", "COPYING"):
            path = os.path.join(gesso, "vendor", name, file)
            if os.path.exists(path):
                parts.append((f"{name} (in gesso's vendor/{name})", "see below", path))
    lines = [
        "# Third-party licences",
        "",
        "gink is under the GNU Affero General Public License, version 3 (LICENSE). These are the licences of what is compiled into it. The fonts shipped beside it are in NOTICE.md.",
        "",
        f"FFmpeg is linked statically under the GNU Lesser General Public License 2.1 or later. Its source is the upstream release {FFMPEG}, unmodified, also offered beside gink's download; gesso builds it with the configuration in its `ffmpeg/` folder (https://github.com/wakamex/gesso), and gink's own source is public, so the program can be relinked against a modified FFmpeg.",
        "",
        "## Libraries compiled in through gesso",
        "",
    ]
    for name, licence, path in parts:
        lines += [f"### {name}", "", f"Licence: {licence}", "", "```", open(path, encoding="utf-8", errors="replace").read().rstrip(), "```", ""]
    rust = subprocess.run(["cargo", "about", "generate", "--locked", "about.hbs"], cwd=os.path.join(ROOT, "core"), capture_output=True, text=True, check=True).stdout
    lines += ["## Rust crates of the core", "", re.sub(r"^# .*\n", "", rust, count=1).replace("\n## ", "\n### ")]
    with open(out, "w") as f:
        f.write("\n".join(lines))


if __name__ == "__main__":
    main()
